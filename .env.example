# Copy this file to .env. Both npm run dev and npm start load it automatically.

# Dashboard address. The default allows access only from this computer.
# Use 0.0.0.0 only if remote access is needed and protected.
UI_HOST=127.0.0.1

# Dashboard port. A generic PORT variable is not read by the app.
UI_PORT=3000

# Application logging: debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# Testing only: exactly 1 enables forwarding your own messages.
FORWARD_OWN=0
